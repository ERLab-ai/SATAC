  "claims": [
    {
      "id": "C01",
      "subject": "hail",
      "object": null,
      "type": "archaeology",
      "text": "تدل الرسوم والنقوش الصخرية في منطقة حائل على تاريخ بشري يقارب عشرة آلاف سنة، وتوثق تغيرات البيئة المحلية.",
      "start": null,
      "end": null,
      "date": "نحو عشرة آلاف سنة من التاريخ البشري؛ لا تاريخ بداية دقيق في هذا السجل",
      "source": "U1472",
      "locator": "Outstanding Universal Value — Brief synthesis",
      "status": "well_supported"
    },
    {
      "id": "C02",
      "subject": "hegra",
      "object": null,
      "type": "archaeology",
      "text": "تعود واجهات المقابر الأثرية المزخرفة في الحِجر إلى القرن الأول قبل الميلاد والقرن الأول الميلادي.",
      "start": -99,
      "end": 100,
      "date": "القرنان الأول ق.م والأول م (ترقيم داخلي فلكي)",
      "source": "U1293",
      "locator": "Description, paragraph 1",
      "status": "well_supported"
    },
    {
      "id": "C03",
      "subject": "hegra",
      "object": "petra",
      "type": "culture",
      "text": "الحِجر والبتراء موقعان مرتبطان بالتراث النبطي؛ لا يثبت هذا الرابط مسار قافلة بعينه أو حدودًا سياسية.",
      "start": null,
      "end": null,
      "date": "العصر النبطي؛ نطاق العلاقة الدقيق غير محدد هنا",
      "source": "U1293",
      "locator": "Description, paragraph 1",
      "additional": "U326",
      "status": "well_supported"
    },
    {
      "id": "C04",
      "subject": "petra",
      "object": null,
      "type": "archaeology",
      "text": "كانت البتراء مركزًا للقوافل النبطية عند تقاطع طرق تربط الجزيرة العربية بمصر وبلاد الشام.",
      "start": null,
      "end": null,
      "date": "العصر النبطي؛ لا سنة محددة في هذا السجل",
      "source": "U326",
      "locator": "Description",
      "status": "well_supported"
    },
    {
      "id": "C05",
      "subject": "jeddah",
      "object": "makkah",
      "type": "pilgrimage",
      "text": "ارتبطت جدة التاريخية بالحج بوصفها ميناء وصول للحجاج القادمين بحرًا إلى مكة.",
      "start": null,
      "end": null,
      "date": "على مدى قرون؛ دون افتراض استمرار غير منقطع",
      "source": "U1361",
      "locator": "Outstanding Universal Value — Criterion (vi)",
      "status": "well_supported"
    },
    {
      "id": "C06",
      "subject": "jeddah",
      "object": "indianocean",
      "type": "trade",
      "text": "تعكس عمارة جدة التاريخية تبادل الخبرات والمواد وتقنيات البناء على طرق المحيط الهندي والبحر الأحمر.",
      "start": 1501,
      "end": null,
      "date": "القرن السادس عشر إلى أوائل القرن العشرين؛ نهاية رقمية غير مثبتة",
      "source": "U1361",
      "locator": "Outstanding Universal Value — Criterion (ii)",
      "status": "approximate",
      "search_window": [
        1501,
        1950
      ]
    },
    {
      "id": "C07",
      "subject": "africa",
      "object": "jeddah",
      "type": "pilgrimage",
      "text": "ارتبط الحج بقدوم بضائع من أفريقيا إلى جدة وبيعها فيها، ضمن التبادل الذي أسهم في تشكيل المدينة.",
      "start": null,
      "end": null,
      "date": "تاريخي؛ غير مؤرخ رقميًا في هذا السجل",
      "source": "U1361",
      "locator": "Outstanding Universal Value — Criterion (vi)",
      "status": "well_supported"
    },
    {
